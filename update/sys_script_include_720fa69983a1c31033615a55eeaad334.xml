        <script><![CDATA[var AutoPopulateNeeditFromEmail = Class.create();
AutoPopulateNeeditFromEmail.prototype = Object.extendsObject(global.AbstractAjaxProcessor, {
    getEmailDetails: function() {
        var userID = this.getParameter('sysparm_user_id');

        var result = {
            email: ''
        };

        var gr = new GlideRecord('sys_user');
        if (gr.get(userID)) {
            result.email = gr.email.toString();
        }

        return JSON.stringify(result);

    },

    type: 'AutoPopulateNeeditFromEmail'
});]]></script>
